### PROMPT 2.2 — ThemeService Angular (Signals)

```
Lis d'abord src/app/core/services/auth.service.ts pour comprendre
le pattern Signals utilisé dans le projet, puis applique le même.

Crée src/app/core/services/theme.service.ts :

import { Injectable, signal, effect, PLATFORM_ID, inject } from '@angular/core';
import { isPlatformBrowser } from '@angular/common';

export type Theme = 'dark' | 'light';

@Injectable({ providedIn: 'root' })
export class ThemeService {
  private platformId = inject(PLATFORM_ID);

  // Signal source de vérité
  private _theme = signal<Theme>(this.#loadInitialTheme());

  // Signal public readonly
  readonly theme = this._theme.asReadonly();
  readonly isDark  = () => this._theme() === 'dark';
  readonly isLight = () => this._theme() === 'light';

  constructor() {
    // Effect : applique le thème au DOM à chaque changement
    effect(() => {
      if (!isPlatformBrowser(this.platformId)) return;
      const t = this._theme();
      const root = document.documentElement;
      root.classList.remove('dark', 'light');
      root.classList.add(t);
      localStorage.setItem('kovixel-theme', t);
    });
  }

  toggle(): void {
    this._theme.update(t => t === 'dark' ? 'light' : 'dark');
  }

  setTheme(theme: Theme): void {
    this._theme.set(theme);
  }

  #loadInitialTheme(): Theme {
    if (!isPlatformBrowser(this.platformId)) return 'dark';
    const saved = localStorage.getItem('kovixel-theme') as Theme | null;
    if (saved === 'dark' || saved === 'light') return saved;
    // Respecte la préférence système si pas de préférence sauvegardée
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark' : 'light';
  }
}

IMPORTANT SSR :
Ajoute aussi dans src/index.html, dans le <head>, AVANT tout script :

<script>
  // Applique le thème immédiatement (évite le flash FOUC)
  (function() {
    try {
      var t = localStorage.getItem('kovixel-theme');
      if (!t) {
        t = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark' : 'light';
      }
      document.documentElement.classList.add(t);
    } catch(e) {
      document.documentElement.classList.add('dark');
    }
  })();
</script>

Ce script inline évite le flash blanc/clair au chargement (FOUC).
```

